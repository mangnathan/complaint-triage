# Copier ce fichier en `.env` (jamais commité) et renseigner les valeurs.
# Les données du CFPB et les textes de l'eCFR sont publics : la collecte n'a besoin d'aucun secret.

# Base de données locale (à partir de la v0.3)
# DATABASE_URL=postgresql://complaint_triage:<mot_de_passe>@localhost:5432/complaint_triage

# Modèle de langage du RAG (à partir de la v0.2), clé créée sur https://aistudio.google.com
# GEMINI_API_KEY=
# Nom exact du modèle, choisi parmi ceux que liste la clé (un modèle Flash de l'offre gratuite)
# GEMINI_MODEL=

# Webhook d'alerte Discord ou Slack (à partir de la v0.3)
# ALERT_WEBHOOK_URL=
