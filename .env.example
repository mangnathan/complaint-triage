# Copier ce fichier en `.env` (jamais commité) et renseigner les valeurs.
# Les données du CFPB et les textes de l'eCFR sont publics : la collecte n'a besoin d'aucun secret.

# Base PostgreSQL locale (à partir de la v0.3). Ces trois lignes sont écrites par
# scripts/db/setup_database.py, avec des mots de passe tirés au hasard : ne pas les remplir à la main.
# DATABASE_URL_OWNER=postgresql://ct_owner:<mot_de_passe>@localhost:5432/complaint_triage
# DATABASE_URL_AGENT_READ=postgresql://ct_agent_read:<mot_de_passe>@localhost:5432/complaint_triage
# DATABASE_URL_AGENT_WRITE=postgresql://ct_agent_write:<mot_de_passe>@localhost:5432/complaint_triage

# Modèle de langage du RAG (à partir de la v0.2), clé créée sur https://aistudio.google.com
# GEMINI_API_KEY=
# Nom exact du modèle, choisi parmi ceux que liste la clé (un modèle Flash de l'offre gratuite)
# GEMINI_MODEL=

# Webhook d'alerte Discord ou Slack (à partir de la v0.3)
# ALERT_WEBHOOK_URL=
